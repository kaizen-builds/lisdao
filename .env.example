# Names only. Copy to web/.env.local (web) or ~/.lisdao/agent.env (agent) and fill in.

# --- web (Next.js) ---
DATABASE_URL=            # Neon/Postgres; POSTGRES_URL also accepted. Optional: in-memory store if unset
AGENT_FEED_TOKEN=        # required: feed/heartbeat POSTs are refused without it (shared with the agent)
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_AGENT_ID=
NEXT_PUBLIC_EXECUTOR_ID=
NEXT_PUBLIC_SPUTNIK_DAO=

# --- agent (agent/browser_agent.py via run-agent.sh) ---
CONTRACT_ID=
EXECUTOR_ID=
AGENT_ID=
WEB_URL=
CHARITY_URL=
FEED_URL=
HEARTBEAT_URL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_RPC=
NEAR_RPC_BACKUP=
POLL_SECONDS=
RECORD_DIR=
HEADLESS=
ONCE=
AGENT_LOG=
AGENT_PYTHON=
